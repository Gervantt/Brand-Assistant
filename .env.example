# Copy to .env. Never commit real values.
# Local `docker compose up` works with this file as-is: compose supplies DB/Redis URLs
# and dev-only defaults for the secrets below.

APP_ENV=local

# --- LLM providers (Groq is the default; others optional) ---
# A provider is used only if its key/URL is set. Routing lives in config/<APP_ENV>.yaml.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# With `docker compose --profile ollama up`: http://ollama:11434
OLLAMA_BASE_URL=
# One-line provider switch (overrides llm.provider from the YAML profile):
# LLM__PROVIDER=anthropic

# --- Embeddings: fastembed (local, default) or gemini ---
EMBEDDING_PROVIDER=fastembed
GEMINI_API_KEY=
# Cross-encoder reranker (local default: on; prod: off to fit 512 MB RAM)
RERANKER_ENABLED=

# --- Infrastructure (leave empty locally; compose fills them in) ---
DATABASE_URL=
REDIS_URL=

# --- Security ---
JWT_SECRET=
DEMO_PASSWORD=
# Shared by the API gateway and the MCP tool server (signs per-request service tokens)
MCP_INTERNAL_SECRET=

# --- Langfuse tracing (empty = tracing disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Web / limits ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_HOUR=20
DAILY_TOKEN_BUDGET=
