# Copy to .env. Never commit real values.
# Local `docker compose up` works with this file as-is: compose supplies DB/Redis URLs
# and dev-only defaults for the secrets below.

APP_ENV=local

# --- LLM providers (Groq is the default; others optional) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# --- Embeddings: fastembed (local, default) or gemini ---
EMBEDDING_PROVIDER=fastembed
GEMINI_API_KEY=

# --- Infrastructure (leave empty locally; compose fills them in) ---
DATABASE_URL=
REDIS_URL=

# --- Security ---
JWT_SECRET=
DEMO_PASSWORD=

# --- Langfuse tracing (empty = tracing disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Web / limits ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_HOUR=20
DAILY_TOKEN_BUDGET=
